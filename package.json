{
  "name": "talki",
  "private": true,
  "description": "Talki — Hebrew early-speech practice app",
  "workspaces": [
    "apps/*"
  ],
  "overrides": {
    "react-native-worklets": "0.10.4",
    "typescript": "~6.0.3",
    "eslint-import-resolver-typescript": "^4.4.5"
  },
  "scripts": {
    "dev": "node tools/dev-server.js",
    "prepare-www": "node tools/prepare_www.js",
    "icons": "python tools/make_native_icons.py",
    "sync": "node tools/prepare_www.js && npx cap sync",
    "android": "node tools/prepare_www.js && npx cap sync android && npx cap open android",
    "ios": "node tools/prepare_www.js && npx cap sync ios && npx cap open ios",
    "mobile:start": "npm run start --workspace=mobile",
    "mobile:android": "npm run android --workspace=mobile",
    "mobile:ios": "npm run ios --workspace=mobile",
    "mobile:web": "npm run web --workspace=mobile",
    "mobile:export": "npm run export:web --workspace=mobile",
    "mobile:typecheck": "npm run typecheck --workspace=mobile",
    "mobile:lint": "npm run lint --workspace=mobile",
    "mobile:test": "npm run test --workspace=mobile",
    "mobile:e2e": "npm run e2e --workspace=mobile",
    "mobile:doctor": "npm run doctor --workspace=mobile"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1"
  }
}
